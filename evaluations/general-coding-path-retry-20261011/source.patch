+def mapped_command(root, workspace, network, command, temporary, dependencies):
+    """Mount the filtered copy at the user-visible path before installing restrictions."""
+    if workspace in (sys.prefix, sys.base_prefix):
+        raise RuntimeError("the workspace must not be the Python installation directory")
+    # Keep the trusted launcher outside the tree that the bind mount replaces.
+    launcher = Path(temporary) / "linux.py"
+    shutil.copyfile(__file__, launcher)
+    argv = [
+        "bwrap", "--die-with-parent", "--cap-drop", "ALL", "--ro-bind", "/", "/",
+        "--dev", "/dev", "--bind", root, workspace,
+        "--bind", temporary, temporary, "--chdir", workspace,
+    ]
+    # An Aster interpreter installed inside the project must remain available.
+    for prefix in dict.fromkeys((sys.prefix, sys.base_prefix)):
+        if Path(prefix).is_relative_to(workspace):
+            argv += ["--ro-bind", prefix, prefix]
+    # The parent authors these environment paths, including language-tool caches.
+    env = {
+        key: os.pathsep.join(
+            workspace + part[len(root):]
+            if part == root or part.startswith(root + "/") else part
+            for part in value.split(os.pathsep)
+        )
+        for key, value in os.environ.items()
+    }
+    # bwrap closes this descriptor before launching the command. A command cannot
+    # forge or erase the namespace setup receipt.
+    with tempfile.TemporaryFile(dir=temporary) as ready:
+        result = subprocess.run(
+            [*argv, "--json-status-fd", str(ready.fileno()), "--", sys.executable, "-I",
+             str(launcher), "--mapped", workspace, network, command, temporary, *dependencies],
+            env=env, pass_fds=(ready.fileno(),), check=False,
+        )
+        ready.seek(0)
+        if not any("exit-code" in json.loads(line) for line in ready):
+            raise RuntimeError(
+                "bubblewrap cannot create a workspace mount namespace; "
+                "check user namespaces and AppArmor (docs/execution-environment.md)"
+            )
+    return result.returncode if result.returncode >= 0 else 128 - result.returncode
+
