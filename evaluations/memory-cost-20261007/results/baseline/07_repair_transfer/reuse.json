        "content": "import unittest\n\nfrom refunds import refund_cents\n\n\nclass RefundTests(unittest.TestCase):\n    def test_sums_payment_record_formats(self):\n        records = [\n            {'amount_minor': 123, 'amount': '9.99'},\n            {'amount': '1.005'},\n            {'amount_minor': -50},\n        ]\n        self.assertEqual(refund_cents(records), 174)\n\n    def test_empty_records(self):\n        self.assertEqual(refund_cents([]), 0)\n\n    def test_negative_decimal_rounding(self):\n        self.assertEqual(refund_cents([{'amount': '-1.005'}]), -101)\n\n\nif __name__ == '__main__':\n    unittest.main()\n"
