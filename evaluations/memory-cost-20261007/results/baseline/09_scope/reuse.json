            "old_text": "def format_timestamp(iso_timestamp, target):\n    raise NotImplementedError\n",
            "new_text": "from datetime import datetime, timezone\nfrom zoneinfo import ZoneInfo\n\n\n_TARGET_TIMEZONES = {\n    \"analytics\": ZoneInfo(\"Asia/Shanghai\"),\n    \"public_api\": timezone.utc,\n}\n_TIMESTAMP_FORMAT = \"%Y-%m-%d %H:%M\"\n\n\ndef format_timestamp(iso_timestamp, target):\n    \"\"\"Format a timezone-aware ISO timestamp for a project interface.\"\"\"\n    try:\n        target_timezone = _TARGET_TIMEZONES[target]\n    except KeyError as exc:\n        raise ValueError(f\"Unknown timestamp target: {target!r}\") from exc\n\n    timestamp = datetime.fromisoformat(iso_timestamp)\n    if timestamp.tzinfo is None or timestamp.utcoffset() is None:\n        raise ValueError(\"iso_timestamp must include a timezone\")\n\n    return timestamp.astimezone(target_timezone).strftime(_TIMESTAMP_FORMAT)\n"
          }
        ]
