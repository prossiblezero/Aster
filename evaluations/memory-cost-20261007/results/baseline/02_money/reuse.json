        "new_text": "from decimal import Decimal, InvalidOperation, ROUND_DOWN\n\n\ndef invoice_amount(value):\n    \"\"\"Format a decimal invoice amount to two places by truncating it.\"\"\"\n    if not isinstance(value, str):\n        raise TypeError(\"invoice amount must be a string\")\n    if not value.strip():\n        raise ValueError(\"invoice amount must not be empty\")\n\n    try:\n        amount = Decimal(value)\n    except InvalidOperation as exc:\n        raise ValueError(\"invoice amount must be a decimal string\") from exc\n\n    if not amount.is_finite():\n        raise ValueError(\"invoice amount must be finite\")\n\n    return format(amount.quantize(Decimal(\"0.01\"), rounding=ROUND_DOWN), \".2f\")\n"
