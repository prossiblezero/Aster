        "path": "billing.py",
        "old_text": "def invoice_amount(value):\n    raise NotImplementedError",
        "new_text": "from decimal import Decimal, InvalidOperation, ROUND_DOWN\n\n\n_CENT = Decimal(\"0.01\")\n\n\ndef invoice_amount(value):\n    \"\"\"Return an invoice amount truncated to cents as a fixed-point string.\"\"\"\n    if not isinstance(value, str):\n        raise TypeError(\"invoice amount must be a string\")\n\n    try:\n        amount = Decimal(value)\n    except InvalidOperation as exc:\n        raise ValueError(\"invalid invoice amount\") from exc\n\n    if not amount.is_finite():\n        raise ValueError(\"invoice amount must be finite\")\n\n    return format(amount.quantize(_CENT, rounding=ROUND_DOWN), \".2f\")"
      },
      "status": "success",
      "reason": ""
    },
    {
      "name": "run_tests",
      "arguments": {
        "code": "import unittest\nfrom billing import invoice_amount\n\nclass InvoiceAmountTests(unittest.TestCase):\n    def test_truncates_and_formats(self):\n        self.assertEqual(invoice_amount(\"12.349\"), \"12.34\")\n        self.assertEqual(invoice_amount(\"12\"), \"12.00\")\n        self.assertEqual(invoice_amount(\"-12.349\"), \"-12.34\")\n        self.assertEqual(invoice_amount(\"0.009\"), \"0.00\")\n\n    def test_keeps_decimal_input_exact(self):\n        self.assertEqual(invoice_amount(\"9999999999999999.999\"), \"9999999999999999.99\")\n\n    def test_rejects_invalid_inputs(self):\n        for value in (\"\", \"not-an-amount\", \"NaN\", \"Infinity\"):\n            with self.subTest(value=value):\n                with self.assertRaises(ValueError):\n                    invoice_amount(value)\n        with self.assertRaises(TypeError):\n            invoice_amount(12.34)\n\nif __name__ == \"__main__\":\n    unittest.main()\n",
