        "new_text": "import csv\nimport io\n\n\n_TICKET_FIELDS = (\"ticket_id\", \"summary\", \"owner\")\n\n\ndef export_tickets(rows):\n    \"\"\"Serialize ticket rows using the project's CSV import format.\"\"\"\n    output = io.StringIO(newline=\"\")\n    writer = csv.DictWriter(\n        output,\n        fieldnames=_TICKET_FIELDS,\n        delimiter=\";\",\n        lineterminator=\"\\r\\n\",\n        extrasaction=\"ignore\",\n    )\n    writer.writeheader()\n    writer.writerows(rows)\n    return output.getvalue().encode(\"utf-8-sig\")\n"
