      "name": "run_tests",
      "arguments": {
        "command": "python -m unittest",
        "code": "import csv\nimport io\nimport unittest\nfrom exports import export_tickets\n\nclass ExportTicketsTests(unittest.TestCase):\n    def test_format_and_encoding(self):\n        result = export_tickets([\n            {\"ticket_id\": \"T-1\", \"summary\": \"登录失败\", \"owner\": \"alice\", \"status\": \"open\"},\n            {\"ticket_id\": \"T-2\", \"summary\": \"needs;review\", \"owner\": \"bob\"},\n        ])\n        self.assertIsInstance(result, bytes)\n        self.assertTrue(result.startswith(b\"\\xef\\xbb\\xbf\"))\n        self.assertEqual(\n            result.decode(\"utf-8-sig\"),\n            \"ticket_id;summary;owner\\r\\nT-1;登录失败;alice\\r\\nT-2;\\\"needs;review\\\";bob\\r\\n\",\n        )\n        self.assertEqual(list(csv.reader(io.StringIO(result.decode(\"utf-8-sig\")), delimiter=\";\")), [\n            [\"ticket_id\", \"summary\", \"owner\"],\n            [\"T-1\", \"登录失败\", \"alice\"],\n            [\"T-2\", \"needs;review\", \"bob\"],\n        ])\n\n    def test_empty_rows_still_has_header(self):\n        self.assertEqual(\n            export_tickets([]),\n            b\"\\xef\\xbb\\xbfticket_id;summary;owner\\r\\n\",\n        )\n\nif __name__ == \"__main__\":\n    unittest.main()\n",
        "timeout": 120
      },
