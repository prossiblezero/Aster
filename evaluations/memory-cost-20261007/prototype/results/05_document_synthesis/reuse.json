      "arguments": {
        "path": "assets.py",
        "old_text": "def asset_key(name, revision):\n    raise NotImplementedError\n",
        "new_text": "import re\n\n\n_WHITESPACE_OR_HYPHENS = re.compile(r\"[\\s-]+\")\n\n\ndef asset_key(name, revision):\n    \"\"\"Return the storage key for an asset name and positive revision.\"\"\"\n    if not isinstance(name, str):\n        raise TypeError(\"name must be a string\")\n\n    if isinstance(revision, bool) or not isinstance(revision, int) or revision <= 0:\n        raise ValueError(\"revision must be a positive integer\")\n\n    normalized_name = _WHITESPACE_OR_HYPHENS.sub(\"_\", name.strip().lower())\n    return f\"assets/v{revision}/{normalized_name}.bin\"\n"
      },
      "status": "success",
      "reason": ""
    },
