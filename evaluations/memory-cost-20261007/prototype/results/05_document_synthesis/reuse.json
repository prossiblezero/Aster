    {
      "name": "run_tests",
      "arguments": {
        "command": "python -m unittest",
        "code": "import unittest\nfrom assets import asset_key\n\nclass AssetKeyTests(unittest.TestCase):\n    def test_normalizes_name_and_builds_storage_key(self):\n        self.assertEqual(asset_key(\"  My--Asset  Name \", 3), \"assets/v3/my_asset_name.bin\")\n        self.assertEqual(asset_key(\"A\\tB\\nC\", 1), \"assets/v1/a_b_c.bin\")\n        self.assertEqual(asset_key(\"C++ 2.0\", 12), \"assets/v12/c++_2.0.bin\")\n\n    def test_accepts_only_positive_integer_revisions(self):\n        self.assertEqual(asset_key(\"icon\", 1), \"assets/v1/icon.bin\")\n        for revision in (0, -1, 1.5, \"1\", None, True, False):\n            with self.subTest(revision=revision):\n                with self.assertRaises(ValueError):\n                    asset_key(\"icon\", revision)\n\n    def test_rejects_non_string_names(self):\n        for name in (None, 1, b\"icon\"):\n            with self.subTest(name=name):\n                with self.assertRaises(TypeError):\n                    asset_key(name, 1)\n\nif __name__ == \"__main__\":\n    unittest.main()\n"
      },
