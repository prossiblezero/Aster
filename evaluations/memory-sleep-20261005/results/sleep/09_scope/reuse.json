        "path": "timestamps.py",
        "old_text": "def format_timestamp(iso_timestamp, target):\n    raise NotImplementedError\n",
        "new_text": "from datetime import datetime, timezone\nfrom zoneinfo import ZoneInfo\n\n\ndef format_timestamp(iso_timestamp, target):\n    \"\"\"Convert an aware ISO 8601 timestamp to a project's display format.\"\"\"\n    if target == \"analytics\":\n        target_timezone = ZoneInfo(\"Asia/Shanghai\")\n    elif target == \"public_api\":\n        target_timezone = timezone.utc\n    else:\n        raise ValueError(f\"unknown timestamp target: {target!r}\")\n\n    timestamp = datetime.fromisoformat(iso_timestamp)\n    if timestamp.tzinfo is None or timestamp.utcoffset() is None:\n        raise ValueError(\"iso_timestamp must include a timezone\")\n\n    return timestamp.astimezone(target_timezone).strftime(\"%Y-%m-%d %H:%M\")\n"
      },
      "status": "success",
      "reason": ""
