        "path": "billing.py",
        "old_text": "def invoice_amount(value):\n    raise NotImplementedError\n",
        "new_text": "\"\"\"Helpers for validating invoice amounts.\"\"\"\n\nimport re\nfrom decimal import Decimal\n\n\n_AMOUNT_PATTERN = re.compile(r\"[0-9]+(?:\\.[0-9]{1,2})?\\Z\")\n_CENT = Decimal(\"0.01\")\n\n\ndef invoice_amount(value):\n    \"\"\"Parse a non-negative invoice amount with at most two decimals.\n\n    Amounts are accepted as strings so callers do not introduce binary\n    floating-point rounding errors.  The returned value is a ``Decimal``\n    normalized to cents.\n    \"\"\"\n    if not isinstance(value, str):\n        raise TypeError(\"invoice amount must be a string\")\n\n    amount = value.strip()\n    if not _AMOUNT_PATTERN.fullmatch(amount):\n        raise ValueError(\"invoice amount must be a non-negative decimal with at most two decimals\")\n\n    return Decimal(amount).quantize(_CENT)\n"
      },
