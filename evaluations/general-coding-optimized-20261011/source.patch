diff --git a/tests/test_inline_verification.py b/tests/test_inline_verification.py
index 6feaa40..d15c033 100644
--- a/tests/test_inline_verification.py
+++ b/tests/test_inline_verification.py
@@ -7,6 +7,26 @@ from aster.core.runtime import Runtime
 from aster.schema import TaskSpec, ToolCall
 
 
+@pytest.mark.core
+async def test_temporary_projects_do_not_inherit_repository_test_configuration(tmp_path):
+    (tmp_path / "pytest.ini").write_text("[pytest]\naddopts = --strict-markers\n")
+    runtime = Runtime(tmp_path, Settings(approval="auto", memory_enabled=False))
+    runtime.start(TaskSpec(prompt="Verify a generated project"))
+    code = '''def test_generated_project(pytester):
+    pytester.makepyfile("import pytest\\n@pytest.mark.project_only\\ndef test_case(): pass\\n")
+    pytester.runpytest("-q").assert_outcomes(passed=1)
+'''
+    try:
+        outcome = await runtime.step(ToolCall(name="run_tests", arguments={
+            "command": "pytest -q -p pytester", "code": code,
+        }))
+        assert outcome.status == "success", outcome.content
+        assert outcome.data["passed_tests"] == 1
+        assert runtime.workspace.snapshot().keys() == {"pytest.ini"}
+    finally:
+        runtime.sandbox.close()
+
+
 @pytest.mark.parametrize("command,code,status,reason", [
     ("pytest -q", "from subject import answer\ndef test_answer(): assert answer() == 42\n", "success", ""),
     ("python -m pytest -q", "from subject import answer\ndef test_answer(): assert answer() == 43\n", "error", "tests_failed"),
