+    elapsed, requests = 0, []
+
+    async def advance(delay):
+        nonlocal elapsed
+        elapsed += delay
+
+    def handler(request):
+        requests.append(request)
+        if elapsed < 20:
+            return httpx.Response(503, headers={"Retry-After": "20"},
+                                  json={"error": {"message": "temporarily unavailable"}})
+        if stream:
+            return httpx.Response(200, stream=Chunks([event("response.completed", response=completed())]))
+        return httpx.Response(200, json=completed())
+
+    install(monkeypatch, handler)
+    monkeypatch.setattr("aster.providers.streaming.asyncio.sleep", advance)
+    model = ModelClient(Settings(api_key="test-s" "tream-" "secret", stream=stream))
+    reply = await model.complete([], [])
+    assert reply.text == "done" and len(requests) == 2
+    assert reply.usage["total_tokens"] == 12
