{
  "description": "Configuration matrix for tool visibility and execution guards; evaluation only, separate from autonomous task counts. Defaults: approval=auto, completion=off, human question callback available.",
  "probes": {
    "worker_start": {"task": "Inspect the repository"},
    "worker_status": {"worker_id": "unused"},
    "worker_message": {"worker_id": "unused", "message": "Inspect tests"},
    "worker_stop": {"worker_id": "unused"},
    "memory_store": {"text": "Service port is 8080.", "evidence_id": "unused"},
    "memory_retrieve": {"query": "Service port"},
    "memory_update": {"lesson_id": "unused", "text": "Service port is 8080.", "evidence_id": "unused"},
    "memory_discard": {"lesson_id": "unused"},
    "ask_user": {"question": "Which file?"},
    "write_file": {"path": "new.txt", "content": "test"},
    "patch_file": {"path": "new.txt", "old_text": "before", "new_text": "after"},
    "plan_exit": {},
    "run_shell": {"command": "echo test"},
    "run_tests": {"command": "python -m pytest -q"}
  },
  "cases": [
    {"id": "enabled", "settings": {"memory_enabled": true, "memory_evolution": true, "auto_dream": true, "max_workers": 2}, "unavailable": {}},
    {"id": "workers_disabled", "settings": {"memory_enabled": true, "memory_evolution": true, "auto_dream": true, "max_workers": 0}, "unavailable": {"workers_disabled": ["worker_start", "worker_status", "worker_message", "worker_stop"]}},
    {"id": "memory_disabled", "settings": {"memory_enabled": false, "memory_evolution": true, "auto_dream": true, "max_workers": 2}, "unavailable": {"memory_disabled": ["memory_store", "memory_retrieve", "memory_update", "memory_discard"]}},
    {"id": "evolution_disabled_keeps_memory_tools", "settings": {"memory_enabled": true, "memory_evolution": false, "auto_dream": true, "max_workers": 2}, "unavailable": {}},
    {"id": "auto_dream_disabled_keeps_memory_tools", "settings": {"memory_enabled": true, "memory_evolution": true, "auto_dream": false, "max_workers": 2}, "unavailable": {}},
    {"id": "no_human_input", "settings": {"memory_enabled": true, "memory_evolution": true, "auto_dream": true, "max_workers": 2}, "question_callback": false, "unavailable": {"user_input_unavailable": ["ask_user"]}},
    {"id": "readonly", "settings": {"memory_enabled": true, "memory_evolution": true, "auto_dream": true, "max_workers": 2, "read_only": true}, "unavailable": {"read_only": ["write_file", "patch_file", "plan_exit"]}},
    {"id": "empty_write_scope", "settings": {"memory_enabled": true, "memory_evolution": true, "auto_dream": true, "max_workers": 2, "write_scope": []}, "unavailable": {"write_scope": ["write_file", "patch_file"]}},
    {"id": "plan_mode", "settings": {"memory_enabled": true, "memory_evolution": true, "auto_dream": true, "max_workers": 2}, "mode": "plan", "unavailable": {"plan_mode": ["write_file", "patch_file"]}},
    {"id": "sandbox_off", "settings": {"memory_enabled": true, "memory_evolution": true, "auto_dream": true, "max_workers": 2, "sandbox": "off"}, "unavailable": {"isolation_required_for_scope": ["run_tests"]}},
    {"id": "sandbox_off_with_plan", "settings": {"memory_enabled": true, "memory_evolution": true, "auto_dream": true, "max_workers": 2, "sandbox": "off"}, "mode": "plan", "unavailable": {"isolation_required_for_scope": ["write_file", "patch_file", "run_shell", "run_tests"]}},
    {"id": "sandbox_off_with_scope", "settings": {"memory_enabled": true, "memory_evolution": true, "auto_dream": true, "max_workers": 2, "sandbox": "off", "write_scope": ["src"]}, "unavailable": {"isolation_required_for_scope": ["write_file", "patch_file", "run_shell", "run_tests"]}},
    {"id": "approval_callback_missing", "settings": {"memory_enabled": true, "memory_evolution": true, "auto_dream": true, "max_workers": 2, "approval": "ask"}, "unavailable": {"approval_unavailable": ["write_file", "patch_file", "plan_exit", "run_shell", "run_tests"]}},
    {"id": "approval_never", "settings": {"memory_enabled": true, "memory_evolution": true, "auto_dream": true, "max_workers": 2, "approval": "never"}, "unavailable": {"approval_unavailable": ["write_file", "patch_file", "plan_exit", "run_shell", "run_tests"]}},
    {"id": "allow_echo_cannot_authorize_tests", "settings": {"memory_enabled": true, "memory_evolution": true, "auto_dream": true, "max_workers": 2, "approval": "never", "rules": [{"prefix": ["echo"], "decision": "allow", "reason": "echo only"}]}, "unavailable": {"approval_unavailable": ["write_file", "patch_file", "plan_exit", "run_tests"]}},
    {"id": "disabled_features_together", "settings": {"memory_enabled": false, "memory_evolution": true, "auto_dream": true, "max_workers": 0, "read_only": true}, "question_callback": false, "unavailable": {"workers_disabled": ["worker_start", "worker_status", "worker_message", "worker_stop"], "memory_disabled": ["memory_store", "memory_retrieve", "memory_update", "memory_discard"], "read_only": ["write_file", "patch_file", "plan_exit"], "user_input_unavailable": ["ask_user"]}}
  ]
}
