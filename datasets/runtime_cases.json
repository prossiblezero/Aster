{
  "schema_version": 1,
  "name": "Aster recovery, hooks and rollout contracts",
  "split": "evaluation",
  "description": "Fixed synthetic action sequences with common goal checks across ablation arms. These are mechanism checks, not autonomous model tasks. Before-hook ablation disables only that lifecycle boundary; sandbox and permission policies stay active.",
  "defaults": {
    "settings": {
      "approval": "auto",
      "sandbox": "required",
      "auto_dream": false,
      "completion": "strict"
    },
    "task": {
      "prompt": "Follow the repository scenario operations.",
      "max_steps": 40,
      "max_turns": 40
    }
  },
  "cases": [
    {
      "id": "recovery_repeated_read",
      "kind": "runtime",
      "suite": "recovery",
      "files": {
        "a.txt": "alpha\n",
        "b.txt": "beta\n"
      },
      "operations": [
        {
          "tool": {
            "name": "read_file",
            "arguments": {
              "path": "a.txt"
            }
          }
        },
        {
          "tool": {
            "name": "read_file",
            "arguments": {
              "path": "a.txt"
            }
          }
        },
        {
          "tool": {
            "name": "read_file",
            "arguments": {
              "path": "b.txt"
            }
          }
        },
        {
          "final": "Scenario complete."
        }
      ],
      "variants": {
        "recovery_off": {
          "settings": {
            "max_recovery": 0
          },
          "expected": {
            "phase": "stopped",
            "stop_reason": "stall_recovery_exhausted"
          }
        },
        "recovery_on": {
          "settings": {
            "max_recovery": 1
          },
          "expected": {
            "phase": "completed",
            "stop_reason": "verified",
            "recovery_used": 1
          }
        }
      },
      "goal": {
        "phase": "completed",
        "stop_reason": "verified"
      }
