        },
        {
          "tool": {
            "name": "run_shell",
            "arguments": {
              "command": "python append.py"
            },
            "call_id": "same-action"
          }
        },
        {
          "final": "Scenario complete."
        }
      ],
      "variants": {
        "before_hook_off": {
          "before_hooks": false,
          "expected": {
            "phase": "completed",
            "stop_reason": "verified",
            "files": {
              "events.txt": "xx"
            },
            "blocked": 0
          }
        },
        "before_hook_on": {
          "before_hooks": true,
          "expected": {
            "phase": "completed",
            "stop_reason": "verified",
            "files": {
              "events.txt": "x"
            },
            "blocked": 1
          }
        }
      },
      "goal": {
        "phase": "completed",
        "stop_reason": "verified",
        "files": {
          "events.txt": "x"
        }
      }
    },
